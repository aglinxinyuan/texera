    {
      "operatorID": "PythonUDFV2-operator-c3c3c3c3-3333-4333-8333-c3c3c3c3c3c3",
      "operatorType": "PythonUDFV2",
      "operatorVersion": "N/A",
      "operatorProperties": {
        "code": "from pytexera import *\nimport pandas as pd\nfrom sklearn.cluster import KMeans\n\nclass ProcessTableOperator(UDFTableOperator):\n    @overrides\n    def process_table(self, table: Table, port: int) -> Iterator[Optional[TableLike]]:\n        k = int(table[\"K\"].iloc[0])\n        X = table[[\"x\", \"y\"]].to_numpy()\n        km = KMeans(n_clusters=k, n_init=10, random_state=0).fit(X)\n        yield pd.DataFrame([{\"K\": k, \"inertia\": float(km.inertia_)}])\n",
        "workers": 1,
        "retainInputColumns": false,
        "defaultEnv": true,
        "envName": "",
        "outputColumns": [
          { "attributeName": "K", "attributeType": "integer" },
          { "attributeName": "inertia", "attributeType": "double" }
        ]
      },
      "inputPorts": [
        { "portID": "input-0", "displayName": "", "allowMultiInputs": false, "isDynamicPort": false, "dependencies": [] }
      ],
      "outputPorts": [
        { "portID": "output-0", "displayName": "", "allowMultiInputs": false, "isDynamicPort": false }
      ],
      "showAdvanced": false,
      "isDisabled": false,
      "customDisplayName": "Cluster with K, report inertia",
